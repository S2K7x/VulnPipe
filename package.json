{
  "name": "vulnpipe",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "probe": "node scripts/probe-treesitter.cjs && node scripts/probe-shapes.cjs",
    "index": "node --experimental-strip-types src/indexer/cli.ts",
    "typecheck": "tsc --noEmit",
    "mcp": "node --experimental-strip-types src/mcp-server/server.ts",
    "bench": "node --experimental-strip-types scripts/bench-idor.ts",
    "measure": "node --experimental-strip-types scripts/measure-pipeline.ts",
    "report": "node --experimental-strip-types scripts/report-demo.ts",
    "e2e": "node --experimental-strip-types scripts/e2e-demo.ts",
    "serve": "node --experimental-strip-types src/orchestration/server.ts",
    "web": "vite --config web/vite.config.ts web",
    "dev": "concurrently -n api,web -c blue,green \"npm:serve\" \"npm:web\"",
    "build": "vite build --config web/vite.config.ts web"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
