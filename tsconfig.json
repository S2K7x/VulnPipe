{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // DOM ajouté pour l'app web ; le code serveur ne s'en sert pas.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false
  },
  // `web` était absent : les composants .tsx n'étaient pas typecheckés du tout.
  "include": ["src/**/*.ts", "web/**/*.ts", "web/**/*.tsx", "scripts/**/*.ts"],
  "exclude": ["node_modules", "**/__fixtures__/**"]
}
